<Project Sdk="Microsoft.NET.Sdk">
  <!-- No game data, no GPU: runs anywhere on every change (ARCHITECTURE 10.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tsuki.Data\Tsuki.Data.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Engine\Tsuki.Engine.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Media\Tsuki.Media.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Ui\Tsuki.Ui.csproj" />
    <!-- Package K6: the app's services, runtime and input mapping are tested without a window (ProjectRulesTests: tests may reference Tsuki.App). -->
    <ProjectReference Include="..\..\src\Tsuki.App\Tsuki.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Package K17: the launcher's logic (src/Tsuki.Launcher/Core, no WPF types) is compiled into the tests. A net10.0 test project cannot reference the net10.0-windows launcher project, and
      the one settings reader / writer both programs use comes from the Tsuki.App reference above.
    -->
    <Compile Include="..\..\src\Tsuki.Launcher\Core\*.cs" Link="Launcher\Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
