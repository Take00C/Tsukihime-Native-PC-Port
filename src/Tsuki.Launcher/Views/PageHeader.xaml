<UserControl x:Class="Tsuki.Launcher.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tsuki.Launcher">
  <StackPanel x:Name="Root" Margin="0,2,0,22">
    <local:TrackedText x:Name="Over" Style="{StaticResource SmallCaps}"/>
    <TextBlock x:Name="Head" Style="{StaticResource Heading}" Margin="0,6,0,0"/>
    <TextBlock x:Name="Desc" Style="{StaticResource Muted}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
