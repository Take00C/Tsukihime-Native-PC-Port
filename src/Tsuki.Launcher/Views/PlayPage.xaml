<UserControl x:Class="Tsuki.Launcher.Views.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tsuki.Launcher"
             xmlns:views="clr-namespace:Tsuki.Launcher.Views"
             xmlns:core="clr-namespace:Tsuki.Launcher.Core">
  <UserControl.Resources>
    <DataTemplate x:Key="ReadyRowTemplate" DataType="{x:Type core:ReadyRow}">
      <Grid Margin="0,0,0,13">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Badge" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#2B7ED6A8" BorderBrush="#667ED6A8" BorderThickness="1">
          <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" FontSize="13.5"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0" LineHeight="16"/>
        </StackPanel>
        <Button x:Name="FixLink" Grid.Column="2" Content="Fix" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="0,3,0,0" Visibility="Collapsed"
                Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Fix}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Warning">
          <Setter TargetName="Badge" Property="Background" Value="#2BE8C877"/>
          <Setter TargetName="Badge" Property="BorderBrush" Value="#66E8C877"/>
          <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/>
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasFix}" Value="True">
          <Setter TargetName="FixLink" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="0,0,0,24">
      <views:HeroView Height="274"/>
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
          <StackPanel>
            <Grid>
              <local:TrackedText Text="READY CHECK" Style="{StaticResource SmallCaps}"/>
              <TextBlock Text="{Binding ReadySummary}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" x:Name="Summary"/>
            </Grid>
            <Rectangle Style="{StaticResource GoldDivider}" Margin="0,11,0,16"/>
            <ItemsControl ItemsSource="{Binding ReadyRows}" ItemTemplate="{StaticResource ReadyRowTemplate}" Focusable="False"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
          <StackPanel>
            <local:TrackedText Text="QUICK SETTINGS" Style="{StaticResource SmallCaps}"/>
            <Rectangle Style="{StaticResource GoldDivider}" Margin="0,11,0,16"/>
            <TextBlock Text="Game language" Style="{StaticResource RowTitle}" FontSize="13.5"/>
            <ListBox Style="{StaticResource Segmented}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Game language">
              <ListBoxItem Content="&#x65E5;&#x672C;&#x8A9E;" FontFamily="Yu Gothic UI, Meiryo UI" Visibility="{Binding JaVisibility}"/>
              <ListBoxItem Content="English" Visibility="{Binding EnVisibility}"/>
              <ListBoxItem Content="&#x7B80;&#x4F53;&#x4E2D;&#x6587;" FontFamily="Microsoft YaHei UI" Visibility="{Binding ZcVisibility}"/>
              <ListBoxItem Content="&#x7E41;&#x9AD4;&#x4E2D;&#x6587;" FontFamily="Microsoft JhengHei UI" Visibility="{Binding ZtVisibility}"/>
            </ListBox>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Fullscreen" Style="{StaticResource RowTitle}" FontSize="13.5"/>
                <TextBlock Text="Borderless, on the monitor you pick." Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Fullscreen, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Fullscreen"/>
            </Grid>
            <TextBlock Text="Button prompts" Style="{StaticResource RowTitle}" FontSize="13.5" Margin="0,18,0,0"/>
            <ListBox Style="{StaticResource Segmented}" SelectedIndex="{Binding PromptsIndex, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Button prompts">
              <ListBoxItem Content="Auto"/>
              <ListBoxItem Content="Keyboard"/>
              <ListBoxItem Content="PlayStation"/>
              <ListBoxItem Content="Xbox"/>
            </ListBox>
            <!-- package K20: Tsukihime.lnk on the desktop, so the game starts without the launcher once the folder is set -->
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Desktop shortcut" Style="{StaticResource RowTitle}" FontSize="13.5"/>
                <TextBlock Text="{Binding DesktopShortcutText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,8,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding DesktopShortcutLabel}" Style="{StaticResource GhostButton}" Command="{Binding DesktopShortcutCommand}" Height="34" Padding="16,0" VerticalAlignment="Center" AutomationProperties.Name="Create desktop shortcut"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
