<UserControl x:Class="Tsuki.Launcher.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tsuki.Launcher"
             xmlns:views="clr-namespace:Tsuki.Launcher.Views">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="DISPLAY" Title="Window and picture"
                        Description="The game draws a 1920 × 1080 picture and fits it into the window with black bars where the shapes differ. These choices are read when the game starts."/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <local:TrackedText Text="MODE" Style="{StaticResource SmallCaps}"/>
          <Rectangle Style="{StaticResource GoldDivider}" Margin="0,11,0,4"/>
          <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Fullscreen" Tag="Borderless fullscreen on the chosen monitor; off, the game opens as a window. In the game, Alt+Enter, F11 or Config › System › Display Mode switches it at any time, and the switch here shows what the game remembers.">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Fullscreen, Mode=TwoWay}" AutomationProperties.Name="Fullscreen"/>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource SettingRow}" Header="VSync" Tag="Wait for the monitor's refresh when showing a frame. Turn it off only if the picture stutters.">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VSync, Mode=TwoWay}" AutomationProperties.Name="VSync"/>
          </HeaderedContentControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,18,0,0">
        <StackPanel>
          <local:TrackedText Text="WINDOW SIZE" Style="{StaticResource SmallCaps}"/>
          <Rectangle Style="{StaticResource GoldDivider}" Margin="0,11,0,16"/>
          <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding WindowSizes}" SelectedItem="{Binding SelectedWindowSize, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Left" Width="520" AutomationProperties.Name="Window size"/>
          <TextBlock Style="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap" Text="{Binding WindowSizeNote}"/>
          <TextBlock Style="{StaticResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"
                     Text="Only the presets that fit the chosen monitor are offered; the game's Config › System › Window Size row offers the same ones."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,18,0,0">
        <StackPanel>
          <local:TrackedText Text="MONITOR" Style="{StaticResource SmallCaps}"/>
          <Rectangle Style="{StaticResource GoldDivider}" Margin="0,11,0,14"/>
          <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" Style="{StaticResource MonitorList}" AutomationProperties.Name="Monitor"/>
          <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE950;" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,1,8,0"/>
            <TextBlock Text="{Binding GraphicsName}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
