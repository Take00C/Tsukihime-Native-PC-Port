<UserControl x:Class="Tsuki.Launcher.Shell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tsuki.Launcher"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </UserControl.Resources>
  <Grid Background="{StaticResource NightBrush}">
    <!-- moonlight in the upper right corner -->
    <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-300,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#2B5E8BFF" Offset="0"/>
          <GradientStop Color="#105E8BFF" Offset="0.5"/>
          <GradientStop Color="#005E8BFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- while the question below is up, nothing behind it takes keys: Tab cannot leave the question and Enter answers it, not the button that asked (package R1) -->
    <Grid x:Name="ContentArea">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ConfirmVisible}" Value="True">
              <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="26,0,20,22">
            <Rectangle Style="{StaticResource GoldDivider}" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding LauncherVersion}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <TextBlock Text="Fan-made. Not affiliated with TYPE&#x2011;MOON." Foreground="#6C7699" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel>
            <Grid Margin="26,34,16,0" Height="50">
              <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Width="46" Height="46">
                <Viewbox Stretch="Uniform">
                  <Canvas Width="44" Height="44">
                    <Path Fill="{StaticResource AccentVerticalBrush}" Data="{StaticResource CrescentGeometry}" Canvas.Left="1" Canvas.Top="1">
                      <Path.Effect>
                        <DropShadowEffect Color="#5E8BFF" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                      </Path.Effect>
                    </Path>
                    <Path Fill="#E9EDF8" Data="{StaticResource SparkleGeometry}" Canvas.Left="34" Canvas.Top="27" RenderTransform="0.55,0,0,0.55,0,0"/>
                  </Canvas>
                </Viewbox>
              </Grid>
              <StackPanel Margin="58,0,0,0" VerticalAlignment="Center">
                <local:TrackedText Text="TSUKIHIME" FontFamily="{StaticResource SerifFont}" FontSize="19" Tracking="1.7" Foreground="{StaticResource TextBrush}"/>
                <local:TrackedText Text="PC PORT" Style="{StaticResource SmallCaps}" FontSize="10.5" Tracking="3.6" Margin="1,2,0,0"/>
              </StackPanel>
            </Grid>
            <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}" Margin="0,34,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== content column ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize"/>
          <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close"/>
        </StackPanel>

        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="32,6,32,0" Focusable="False" IsTabStop="False">
          <ContentControl.RenderTransform>
            <TranslateTransform x:Name="PageShift"/>
          </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ===== footer: status line, Log, PLAY ===== -->
        <Border Grid.Row="2" Height="88" Background="#990A0F24" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
          <Grid Margin="32,0,32,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{StaticResource MoonPaleBrush}" Margin="0,1,12,0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#9CD2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Log" Style="{StaticResource GhostButton}" Command="{Binding OpenLogCommand}" Height="42" Padding="22,0" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="{Binding PlayLabel}" Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- a short message above the footer -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="32,0,32,18" Padding="18,11" CornerRadius="10" MaxWidth="640"
                Background="#F2161F45" BorderBrush="#668FA6FF" BorderThickness="1" Visibility="{Binding ToastVisible, Converter={StaticResource B2V}}">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
          </Border.Effect>
          <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" FontSize="13"/>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== a yes / no question ===== -->
    <Grid x:Name="ConfirmOverlay" Visibility="{Binding ConfirmVisible, Converter={StaticResource B2V}}" Background="#B3060A1A" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="False">
      <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Background="#FF121A3A" Padding="28,24,28,22">
        <Border.Effect>
          <DropShadowEffect Color="#5E8BFF" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="{Binding Confirm.Title}" Style="{StaticResource Heading}" FontSize="23"/>
          <Rectangle Style="{StaticResource GoldDivider}" Margin="0,14,0,14"/>
          <TextBlock Text="{Binding Confirm.Body}" Style="{StaticResource Muted}" FontSize="13" LineHeight="20" Foreground="#B9C3E3"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfirmCancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding ConfirmNoCommand}" Height="38" Padding="22,0" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="ConfirmYesButton" Content="{Binding Confirm.ConfirmLabel}" Style="{StaticResource AccentButton}" Command="{Binding ConfirmYesCommand}" Height="38" Padding="24,0" IsDefault="True"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
