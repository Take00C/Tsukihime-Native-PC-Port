<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Tsuki.Launcher">

  <!-- ===== Palette: blue glass moon ===== -->
  <Color x:Key="NightTop">#0A0F24</Color>
  <Color x:Key="NightBottom">#0E1532</Color>
  <Color x:Key="PanelColor">#121A3A</Color>
  <Color x:Key="MoonBlue">#5E8BFF</Color>
  <Color x:Key="MoonPale">#9CD2FF</Color>
  <Color x:Key="GoldColor">#D9C58E</Color>
  <Color x:Key="SuccessColor">#7ED6A8</Color>
  <Color x:Key="WarningColor">#E8C877</Color>

  <LinearGradientBrush x:Key="NightBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource NightTop}" Offset="0"/>
    <GradientStop Color="{StaticResource NightBottom}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NightTopBrush" Color="{StaticResource NightTop}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#D9121A3A"/>
  <SolidColorBrush x:Key="PanelSolidBrush" Color="#121A3A"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#CC0B1129"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#268FA6FF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E9EDF8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#98A2C8"/>
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
  <SolidColorBrush x:Key="GoldLineBrush" Color="#33D9C58E"/>
  <SolidColorBrush x:Key="MoonPaleBrush" Color="{StaticResource MoonPale}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#800A0F24"/>
  <SolidColorBrush x:Key="SelectedFillBrush" Color="#235E8BFF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource MoonBlue}" Offset="0"/>
    <GradientStop Color="{StaticResource MoonPale}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentVerticalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource MoonPale}" Offset="0"/>
    <GradientStop Color="{StaticResource MoonBlue}" Offset="1"/>
  </LinearGradientBrush>

  <!-- ===== Fonts (all ship with Windows 11) ===== -->
  <FontFamily x:Key="SerifFont">Palatino Linotype, Georgia, Yu Mincho, MS Mincho</FontFamily>
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Microsoft YaHei UI, Microsoft JhengHei UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ===== The crescent: an original drawing, a disc with a second disc cut out ===== -->
  <CombinedGeometry x:Key="CrescentGeometry" GeometryCombineMode="Exclude">
    <CombinedGeometry.Geometry1>
      <EllipseGeometry Center="20,22" RadiusX="17" RadiusY="17"/>
    </CombinedGeometry.Geometry1>
    <CombinedGeometry.Geometry2>
      <EllipseGeometry Center="28,17" RadiusX="14.5" RadiusY="14.5"/>
    </CombinedGeometry.Geometry2>
  </CombinedGeometry>
  <StreamGeometry x:Key="SparkleGeometry">M 0,-6 C 0.6,-1.6 1.6,-0.6 6,0 C 1.6,0.6 0.6,1.6 0,6 C -0.6,1.6 -1.6,0.6 -6,0 C -1.6,-0.6 -0.6,-1.6 0,-6 Z</StreamGeometry>

  <!-- ===== Defaults ===== -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="IconText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  </Style>
  <Style TargetType="local:TrackedText" x:Key="SmallCaps">
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Tracking" Value="2"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
  </Style>

  <!-- ===== Cards ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="22,18,22,20"/>
  </Style>
  <Style x:Key="GoldDivider" TargetType="Rectangle">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Fill" Value="{StaticResource GoldLineBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="#10FFFFFF" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#598FA6FF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#9CD2FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="#0A0F24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#5E8BFF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#9CD2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource MoonPaleBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12.5" FontWeight="SemiBold"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
              <Setter TargetName="T" Property="Foreground" Value="#9CD2FF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the big luminous PLAY button -->
  <Style x:Key="PlayButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Width="188" Height="54">
            <Border x:Name="Glow" CornerRadius="13" Background="{StaticResource AccentBrush}">
              <Border.Effect>
                <DropShadowEffect Color="#5E8BFF" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
              </Border.Effect>
            </Border>
            <Border x:Name="Rim" CornerRadius="13" BorderThickness="1" BorderBrush="#66FFFFFF">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#40FFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                  <GradientStop Color="#1A0A0F24" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="Ico" Style="{StaticResource IconText}" Text="&#xE768;" Foreground="#0A0F24" FontSize="17" VerticalAlignment="Center" Margin="0,1,12,0"/>
              <local:TrackedText x:Name="Label" Text="{TemplateBinding Content}" Foreground="#0A0F24" FontFamily="{StaticResource BodyFont}" FontSize="17" FontWeight="Bold" Tracking="3.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glow" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#9CD2FF" BlurRadius="38" ShadowDepth="0" Opacity="0.75"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Rim" Property="BorderBrush" Value="#FFFFFFFF"/>
              <Setter TargetName="Rim" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Glow" Property="Effect" Value="{x:Null}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- title bar buttons -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <TextBlock x:Name="G" Style="{StaticResource IconText}" Text="{TemplateBinding Content}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
              <Setter TargetName="G" Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
              <Setter TargetName="G" Property="Foreground" Value="#9CD2FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <TextBlock x:Name="G" Style="{StaticResource IconText}" Text="{TemplateBinding Content}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
              <Setter TargetName="G" Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Sidebar navigation ===== -->
  <Style x:Key="NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid Height="44" Margin="12,2">
                  <Border x:Name="Bg" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
                  <Border x:Name="Bar" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,0" Background="{StaticResource AccentVerticalBrush}" Opacity="0">
                    <Border.Effect>
                      <DropShadowEffect Color="#5E8BFF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Ico" Style="{StaticResource IconText}" Text="{Binding Glyph}" Width="22" Foreground="{StaticResource MutedBrush}" FontSize="16" TextAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Txt" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource TextBrush}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#1F8FA6FF"/>
                    <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource MoonPaleBrush}"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bg" Property="BorderBrush" Value="#9CD2FF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Segmented control: a ListBox of ListBoxItems ===== -->
  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Padding" Value="8,8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#9CD2FF"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#0A0F24"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Bd" Property="Effect">
                      <Setter.Value>
                        <DropShadowEffect Color="#5E8BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="#66090E22" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Switch ===== -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Right">
            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#9CD2FF"/>
              <Setter TargetName="Track" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#9CD2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="#99FFFFFF"/>
              <Setter TargetName="Knob" Property="Fill" Value="#0A0F24"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
              <Setter TargetName="Track" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#5E8BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#8C9CD2FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a row of a settings card: title and description on the left, the control on the right -->
  <Style x:Key="SettingRow" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,12,24,12">
              <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Bottom"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the scroll host inside a text box: just the content, no bars, no corner box -->
  <Style x:Key="HostScroll" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <ScrollContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Text box ===== -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="#665E8BFF"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource HostScroll}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#9CD2FF"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#598FA6FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== page scroll viewer: the bar sits in the page margin, so that the content width never changes ===== -->
  <Style x:Key="PageScroll" TargetType="ScrollViewer">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="Transparent">
            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,-24,0" Orientation="Vertical"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Scroll bar: a thin moon-blue thumb ===== -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent" Width="8">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#40BFD2FF" CornerRadius="4" Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ===== A list of cards where one is selected (monitors) ===== -->
  <Style x:Key="MonitorList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Margin="0,0,0,8" Padding="16,12" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" FontSize="20" Foreground="{StaticResource MutedBrush}" x:Name="Ico" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Ellipse Grid.Column="2" Width="18" Height="18" Stroke="#66FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" x:Name="Radio"/>
                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#0A0F24" VerticalAlignment="Center" x:Name="Dot" Visibility="Collapsed"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#598FA6FF"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFillBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B39CD2FF"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource MoonPaleBrush}"/>
                    <Setter TargetName="Radio" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Radio" Property="Stroke" Value="Transparent"/>
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#9CD2FF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Four tiles in a row, one selected (languages) ===== -->
  <Style x:Key="TileList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Margin="0,0,10,0" Padding="16,18,16,16" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#598FA6FF"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFillBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B39CD2FF"/>
                    <Setter TargetName="Bd" Property="Effect">
                      <Setter.Value>
                        <DropShadowEffect Color="#5E8BFF" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#9CD2FF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
