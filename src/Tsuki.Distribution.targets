<Project>
  <!--
    The documents that travel with a published folder (GitHub PR #2): the README and the pages it links to, with the README's logo
    (assets/branding/tsukihime-logo.png; the owner's decision, K46). release-check refuses any other picture in a folder to be released.
  -->
  <ItemGroup>
    <None Include="$(TsukiRepoRoot)README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)CONTRIBUTING.md" Link="CONTRIBUTING.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)assets/branding/tsukihime-logo.png" Link="assets/branding/tsukihime-logo.png" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)docs/SETUP_GUIDE.md;$(TsukiRepoRoot)docs/THIRD_PARTY.md;$(TsukiRepoRoot)docs/LINUX.md;$(TsukiRepoRoot)docs/MACOS.md"
          Link="docs/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    A Unix publish carries the launcher's third-party notices and the self-contained runtime's notices, without compiler XML files.
    FFmpeg itself comes from Directory.Build.props: Linux uses the BtbN LGPL 3 build; macOS uses our minimal LGPL 2.1-or-later build.
  -->
  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <None Include="$(TsukiRepoRoot)src/Tsuki.Launcher/Licenses/MPL-2.0.txt" Link="licenses/knife-MPL-2.0.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)src/Tsuki.Launcher/Licenses/SDL3-zlib.txt" Link="licenses/SDL3-zlib.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)LICENSE" Link="licenses/LICENSE.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)docs/THIRD_PARTY.md" Link="licenses/THIRD_PARTY.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">
    <None Include="$(TsukiRepoRoot)src/Tsuki.Launcher/Licenses/LGPL-3.0.txt" Link="licenses/FFmpeg-LGPL.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)src/Tsuki.Launcher/Licenses/GPL-3.0.txt" Link="licenses/FFmpeg-GPL-3.0.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TsukiRepoRoot)docs/LINUX.md" Link="LINUX.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <None Include="$(TsukiRepoRoot)docs/MACOS.md" Link="MACOS.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="TsukiIncludeRuntimeNotices" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_TsukiRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(_TsukiRuntimePack)' == ''" Text="The .NET runtime package was not resolved for its licence notices." />
    <Error Condition="!Exists('%(_TsukiRuntimePack.PackageDirectory)/LICENSE.TXT') or !Exists('%(_TsukiRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT')"
           Text="The resolved .NET runtime package is missing its licence or third-party notices." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_TsukiRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="licenses/dotnet-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_TsukiRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="licenses/dotnet-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
