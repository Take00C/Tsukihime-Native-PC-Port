<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Tsuki.Launcher.Avalonia.Views" x:Class="Tsuki.Launcher.Avalonia.Views.HelpPage">
  <UserControl.Styles>
    <Style Selector="TextBlock.LicenseName">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.LicenseTag">
      <Setter Property="Background" Value="#1FD9C58E"/>
      <Setter Property="BorderBrush" Value="#40D9C58E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,1,8,2"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer Classes="Page">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="HELP &amp; ABOUT" Title="About this port" Description="{Binding AboutLine}"/>
      <Border Classes="Card">
        <StackPanel>
          <TextBlock Text="WHAT THIS IS" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <TextBlock Classes="Muted" FontSize="13" LineHeight="20" Foreground="{StaticResource SoftTextBrush}"
                     Text="TSUKIHIME PC Port is a clean reimplementation of the game's engine. Every time it starts it reads the game files of your own copy, the extracted CUSA47999 folder, and plays them with sound, movies, menus and saves. Nothing from the game is included in the port, and nothing in your game folder is ever changed."/>
          <TextBlock Classes="Muted" FontSize="13" LineHeight="20" Foreground="{StaticResource SoftTextBrush}" Margin="0,10,0,0"
                     Text="Tsukihime PC port is an unofficial fan project. It is not affiliated with, endorsed by or supported by TYPE-MOON, Aniplex, HuneX or Sony. TSUKIHIME and all of its art, music, text and characters belong to their rights holders. This program contains no game data: it only plays the files of a copy of TSUKIHIME -A piece of blue glass moon- (PS4) that you own. You must supply those files yourself; this project does not provide the files or link to any source of them, and it will not accept contributions that do."/>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="UPDATES" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,4"/>
          <HeaderedContentControl Classes="SettingRow" Header="Check for updates when the launcher starts" Tag="{Binding UpdateCheckDescription}" IsEnabled="{Binding UpdatesOn}">
            <CheckBox Classes="Switch" IsChecked="{Binding CheckForUpdatesOnStart, Mode=TwoWay}"/>
          </HeaderedContentControl>
          <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
            <Viewbox Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
              <Path Classes="Icon" Data="{StaticResource SyncIcon}" Stroke="{StaticResource MoonPaleBrush}" StrokeThickness="1.9"/>
            </Viewbox>
            <TextBlock x:Name="UpdateStatusText" Grid.Column="1" Text="{Binding UpdateStatus}" Classes="Muted" FontSize="13" Foreground="{StaticResource SoftTextBrush}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Check now" Classes="GhostButton" Command="{Binding CheckUpdatesNowCommand}" Margin="0,0,8,0"/>
            <Button Content="Open the Releases page" Classes="GhostButton" Command="{Binding OpenReleasesPageCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="SETUP GUIDE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <TextBlock Classes="Muted" FontSize="13" LineHeight="20" Foreground="{StaticResource SoftTextBrush}"
                     Text="The setup guide, which comes with the programs, is the player's guide: what you need, how your own game files must be laid out (the game folder, the update folder beside it), the first start, every key, and what each message of the launcher and the game means."/>
          <TextBlock Classes="Muted" FontSize="13" LineHeight="20" Foreground="{StaticResource SoftTextBrush}" Margin="0,10,0,0" IsVisible="{Binding IsMac}"
                     Text="If macOS will not open the port, use System Settings › Privacy &amp; Security › Open Anyway; after an update it may ask once more."/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Open the setup guide" Classes="GhostButton" Command="{Binding OpenGuideCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="THE KEYS YOU NEED" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,10"/>
          <ItemsControl ItemsSource="{Binding EssentialKeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="300,*" Margin="0,5">
                  <Border Classes="KeyCap">
                    <TextBlock Text="{Binding Keys}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="280"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Action}" Classes="Muted" VerticalAlignment="Center" Foreground="{StaticResource SoftTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="Muted" Margin="0,10,0,0" Text="The Controls page lists every key."/>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="IF SOMETHING GOES WRONG" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <TextBlock Classes="Muted" Foreground="{StaticResource SoftTextBrush}" FontSize="13" LineHeight="20"
                     Text="The game writes last_run.log next to your saves each time it runs, and crash.log when it fails; the launcher writes launcher.log there. The ready check on the Play page says what is missing."/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Open the log" Classes="GhostButton" Command="{Binding OpenLogCommand}" Margin="0,0,8,0"/>
            <Button Content="Open the saves folder" Classes="GhostButton" Command="{Binding OpenSavesFolderCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="LICENSES" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="knife" Classes="LicenseName"/>
            <Border Classes="LicenseTag"><TextBlock Text="MPL-2.0" FontSize="11" Foreground="{StaticResource GoldBrush}"/></Border>
          </StackPanel>
          <TextBlock Classes="Muted" Margin="0,3,0,14"
                     Text="Parts of the menu and story code are translations of AuroraWright's knife (github.com/AuroraWright/knife). Those files stay under the Mozilla Public License 2.0."/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FFmpeg" Classes="LicenseName"/>
            <Border Classes="LicenseTag"><TextBlock x:Name="FfmpegLicenceTag" Text="{Binding FfmpegLicence}" FontSize="11" Foreground="{StaticResource GoldBrush}"/></Border>
          </StackPanel>
          <!-- the Mac app carries its own LGPL 2.1-or-later FFmpeg build and keeps the notices in Tsukihime.app/Contents/Resources (UnixLauncherPages) -->
          <TextBlock x:Name="FfmpegLicenceText" Classes="Muted" Margin="0,3,0,14" Text="{Binding FfmpegLicenceText}"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="SDL3" Classes="LicenseName"/>
            <Border Classes="LicenseTag"><TextBlock Text="zlib" FontSize="11" Foreground="{StaticResource GoldBrush}"/></Border>
          </StackPanel>
          <TextBlock Classes="Muted" Margin="0,3,0,14"
                     Text="The window, the keyboard, mouse and pads, the audio device and the folder dialog of the game."/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="MIT libraries" Classes="LicenseName"/>
            <Border Classes="LicenseTag"><TextBlock Text="MIT" FontSize="11" Foreground="{StaticResource GoldBrush}"/></Border>
          </StackPanel>
          <TextBlock Classes="Muted" Margin="0,3,0,14"
                     Text="The .NET runtime (Microsoft, .NET Foundation and Contributors), Avalonia, SkiaSharp and HarfBuzzSharp (the launcher's window), Silk.NET (the OpenGL binding), SDL3-CS (ppy, the SDL binding) and FFmpeg.AutoGen (Ruslan Balanukhin, the FFmpeg binding) travel with the programs; their copyright and permission notices are in the licenses folder and THIRD_PARTY.md."/>
          <TextBlock x:Name="NoticesText" Classes="Muted" Text="{Binding NoticesText}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
