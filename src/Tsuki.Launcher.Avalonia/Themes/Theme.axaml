<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tsuki.Launcher.Avalonia.Themes.Theme">
  <!-- the Windows launcher's palette (src/Tsuki.Launcher/Themes/Theme.xaml): blue glass moon -->
  <Color x:Key="NightTop">#0A0F24</Color>
  <Color x:Key="NightBottom">#0E1532</Color>
  <Color x:Key="MoonBlue">#5E8BFF</Color>
  <Color x:Key="MoonPale">#9CD2FF</Color>
  <Color x:Key="Gold">#D9C58E</Color>
  <!-- Fluent's accent (switches, selections, focus) is the moon blue, not the system's -->
  <Color x:Key="SystemAccentColor">#5E8BFF</Color>
  <Color x:Key="SystemAccentColorDark1">#4F78E0</Color>
  <Color x:Key="SystemAccentColorDark2">#3F64C0</Color>
  <Color x:Key="SystemAccentColorDark3">#3050A0</Color>
  <Color x:Key="SystemAccentColorLight1">#7DA8FF</Color>
  <Color x:Key="SystemAccentColorLight2">#9CD2FF</Color>
  <Color x:Key="SystemAccentColorLight3">#C4E3FF</Color>
  <LinearGradientBrush x:Key="NightBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="{StaticResource NightTop}" Offset="0"/>
    <GradientStop Color="{StaticResource NightBottom}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBrush" Color="#CC0B1129"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#268FA6FF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#D9121A3A"/>
  <SolidColorBrush x:Key="PanelSolidBrush" Color="#121A3A"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#800A0F24"/>
  <SolidColorBrush x:Key="SelectedFillBrush" Color="#235E8BFF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E9EDF8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#98A2C8"/>
  <SolidColorBrush x:Key="SoftTextBrush" Color="#B9C3E3"/>
  <SolidColorBrush x:Key="MoonPaleBrush" Color="{StaticResource MoonPale}"/>
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
  <SolidColorBrush x:Key="GoldLineBrush" Color="#33D9C58E"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#7ED6A8"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E8C877"/>
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="{StaticResource MoonBlue}" Offset="0"/>
    <GradientStop Color="{StaticResource MoonPale}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentVerticalBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="{StaticResource MoonPale}" Offset="0"/>
    <GradientStop Color="{StaticResource MoonBlue}" Offset="1"/>
  </LinearGradientBrush>
  <!-- no font files ship with the launcher: the first of each list that the system has is used (Windows, macOS, then common Linux desktops and SteamOS) -->
  <FontFamily x:Key="SerifFont">Palatino Linotype, Palatino, Book Antiqua, Georgia, Noto Serif, DejaVu Serif, Liberation Serif, Times New Roman</FontFamily>
  <FontFamily x:Key="BodyFont">Segoe UI, Helvetica Neue, Noto Sans, Ubuntu, Cantarell, DejaVu Sans, Liberation Sans, Arial</FontFamily>
  <FontFamily x:Key="JapaneseFont">Yu Mincho, Hiragino Mincho ProN, Noto Serif CJK JP, Noto Sans CJK JP, IPAexMincho, Yu Gothic UI</FontFamily>
  <FontFamily x:Key="ChineseSimplifiedFont">Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Noto Sans SC, WenQuanYi Micro Hei</FontFamily>
  <FontFamily x:Key="ChineseTraditionalFont">Microsoft JhengHei UI, PingFang TC, Noto Sans CJK TC, Noto Sans TC, WenQuanYi Micro Hei</FontFamily>
  <!-- the crescent: a disc with a second disc cut out (the Windows launcher's CrescentGeometry) -->
  <CombinedGeometry x:Key="CrescentGeometry" GeometryCombineMode="Exclude">
    <CombinedGeometry.Geometry1><EllipseGeometry Center="20,22" RadiusX="17" RadiusY="17"/></CombinedGeometry.Geometry1>
    <CombinedGeometry.Geometry2><EllipseGeometry Center="28,17" RadiusX="14.5" RadiusY="14.5"/></CombinedGeometry.Geometry2>
  </CombinedGeometry>
  <StreamGeometry x:Key="SparkleGeometry">M 0,-6 C 0.6,-1.6 1.6,-0.6 6,0 C 1.6,0.6 0.6,1.6 0,6 C -0.6,1.6 -1.6,0.6 -6,0 C -1.6,-0.6 -0.6,-1.6 0,-6 Z</StreamGeometry>
  <!-- the icons of the pages (24 x 24, stroked): the Windows launcher's Segoe Fluent Icons are not on macOS or Linux -->
  <StreamGeometry x:Key="PlayIcon">M7.5,4.8 L18.5,12 L7.5,19.2 Z</StreamGeometry>
  <StreamGeometry x:Key="DownloadIcon">M12,3.5 L12,14.5 M7,9.5 L12,14.5 L17,9.5 M5,19.5 L19,19.5</StreamGeometry>
  <StreamGeometry x:Key="SyncIcon">M19.5,12 A7.5,7.5 0 0 1 6.7,17.3 M4.5,12 A7.5,7.5 0 0 1 17.3,6.7 M17.6,3 L17.6,6.9 L13.7,6.9 M6.4,21 L6.4,17.1 L10.3,17.1</StreamGeometry>
  <StreamGeometry x:Key="WarningIcon">M12,3.5 L21.5,20 L2.5,20 Z M12,9.5 L12,14.5 M12,17 L12,17.6</StreamGeometry>
  <StreamGeometry x:Key="SoundIcon">M3.5,9 L7.5,9 L12.5,4.5 L12.5,19.5 L7.5,15 L3.5,15 Z M15.5,9 C17,10.5 17,13.5 15.5,15 M18,6.5 C21,9.5 21,14.5 18,17.5</StreamGeometry>
  <StreamGeometry x:Key="HistoryIcon">M4.5,12 A7.5,7.5 0 1 0 6.7,6.7 M3.8,3.8 L3.8,7.8 L7.8,7.8 M12,8 L12,12.5 L15,14.5</StreamGeometry>
  <StreamGeometry x:Key="ChipIcon">M5,6 L19,6 L19,18 L5,18 Z M9,10 L15,10 L15,14 L9,14 Z M8,3 L8,6 M12,3 L12,6 M16,3 L16,6 M8,18 L8,21 M12,18 L12,21 M16,18 L16,21</StreamGeometry>
</ResourceDictionary>
