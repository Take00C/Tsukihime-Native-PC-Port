<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Tsuki.Launcher.Avalonia.Views" x:Class="Tsuki.Launcher.Avalonia.Views.SavesPage">
  <ScrollViewer Classes="Page">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="SAVES" Title="Keep your progress safe"
                        Description="All 140 slots, the system data and the config are in one file, save.dat. Back it up before you try anything new, and restore it whenever you like."/>
      <Border Classes="Card">
        <StackPanel>
          <TextBlock Text="SAVE DATA" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <Grid ColumnDefinitions="*,Auto,8,Auto">
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{Binding SaveText}" Classes="RowTitle" FontSize="13.5" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding DataDirectory}" Classes="Muted" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Open folder" Classes="GhostButton" Command="{Binding OpenSavesFolderCommand}" Height="38"/>
            <Button Grid.Column="3" Content="Back up now" Classes="AccentButton" Command="{Binding BackupNowCommand}" Height="38"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="BACKUPS" Classes="SmallCaps"/>
            <Button Content="Open backups folder" Classes="LinkButton" Command="{Binding OpenBackupsFolderCommand}" HorizontalAlignment="Right"/>
          </Grid>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,8"/>
          <TextBlock x:Name="NoBackupsText" Text="No backups yet. Press Back up now to make the first one." Classes="Muted" Margin="0,8,0,4" IsVisible="{Binding NoBackups}"/>
          <ItemsControl x:Name="BackupList" ItemsSource="{Binding Backups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="36,*,Auto" Height="56">
                  <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path Classes="Icon" Data="{StaticResource HistoryIcon}" Stroke="{StaticResource MoonPaleBrush}"/>
                  </Viewbox>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="RowTitle" FontSize="13.5"/>
                    <TextBlock Text="{Binding Detail}" Classes="Muted" FontSize="12" Margin="0,1,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Restore" Classes="GhostButton" Padding="16,6" VerticalAlignment="Center"
                          Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                  <Rectangle Grid.ColumnSpan="3" Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Bottom"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="IMPORT A PS4 SAVE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <TextBlock Classes="Muted" MaxWidth="660"
                     Text="Bring your progress over from a PS4 or from shadPS4: the 4 MiB save image (savedata000). The file is only read, never changed. It replaces save.dat after your current save has been backed up."/>
          <Button Content="Choose a file…" Classes="GhostButton" Command="{Binding ImportCommand}" Height="38" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
