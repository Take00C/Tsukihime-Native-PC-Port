<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Tsuki.Launcher.Avalonia.Views" x:Class="Tsuki.Launcher.Avalonia.Views.LanguagePage">
  <ScrollViewer Classes="Page">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="LANGUAGE &amp; SOUND" Title="Voice and text"
                        Description="The language of the story, the menus and the pictures that carry text. The voices stay Japanese in every language, as in the original game."/>
      <Border Classes="Card">
        <StackPanel>
          <TextBlock Text="GAME LANGUAGE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <ListBox Classes="Tiles" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
            <ListBoxItem IsVisible="{Binding JaAvailable}">
              <StackPanel>
                <TextBlock Text="日本語" FontFamily="{StaticResource JapaneseFont}" FontSize="24"/>
                <TextBlock Text="Japanese" Classes="Muted" Margin="0,5,0,0"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem IsVisible="{Binding EnAvailable}">
              <StackPanel>
                <TextBlock Text="English" FontFamily="{StaticResource SerifFont}" FontSize="24"/>
                <TextBlock Text="English" Classes="Muted" Margin="0,5,0,0"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem IsVisible="{Binding ZcAvailable}">
              <StackPanel>
                <TextBlock Text="简体中文" FontFamily="{StaticResource ChineseSimplifiedFont}" FontSize="23"/>
                <TextBlock Text="Simplified Chinese" Classes="Muted" Margin="0,5,0,0"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem IsVisible="{Binding ZtAvailable}">
              <StackPanel>
                <TextBlock Text="繁體中文" FontFamily="{StaticResource ChineseTraditionalFont}" FontSize="23"/>
                <TextBlock Text="Traditional Chinese" Classes="Muted" Margin="0,5,0,0"/>
              </StackPanel>
            </ListBoxItem>
          </ListBox>
          <TextBlock Classes="Muted" Margin="2,14,0,0"
                     Text="Takes effect the next time the game starts. Inside the game, Config also switches the language at once. A language your copy of the game does not carry is not offered."/>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="SOUND" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="22" Height="22" Margin="0,2,16,0" VerticalAlignment="Top">
              <Path Classes="Icon" Data="{StaticResource SoundIcon}" Stroke="{StaticResource MoonPaleBrush}"/>
            </Viewbox>
            <StackPanel>
              <TextBlock Text="Change volumes in the game's Config" Classes="RowTitle"/>
              <TextBlock Classes="Muted" Margin="0,4,0,0" MaxWidth="560"
                         Text="Music, sound effects, system sounds and voices are saved with your progress, so they are set in the game itself: open the system menu (Esc), then Config."/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
