<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Tsuki.Launcher.Avalonia.Views" x:Class="Tsuki.Launcher.Avalonia.Views.ControlsPage">
  <ScrollViewer Classes="Page">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="CONTROLS" Title="Keyboard, mouse and pad"
                        Description="Play with the keyboard and mouse, or with a pad. The game switches between them as you go, and the on-screen button hints follow."/>
      <Border Classes="Card">
        <StackPanel>
          <TextBlock Text="BUTTON PROMPTS" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <!-- 520 wide, narrower in a small window (the column stops at 520 and gives way below) -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="520"/></Grid.ColumnDefinitions>
            <ListBox Classes="Segmented" SelectedIndex="{Binding PromptsIndex, Mode=TwoWay}">
              <ListBoxItem Content="Auto"/>
              <ListBoxItem Content="Keyboard"/>
              <ListBoxItem Content="PlayStation"/>
              <ListBoxItem Content="Xbox"/>
            </ListBox>
          </Grid>
          <TextBlock Classes="Muted" Margin="2,12,0,0" MaxWidth="640"
                     Text="Auto shows key caps for the keyboard and mouse, the game's own PlayStation icons for a PlayStation pad and Xbox glyphs for any other pad, and follows the device you used last. The other three keep one style."/>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="KEYBOARD AND MOUSE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,10"/>
          <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="300,*" Margin="0,5">
                  <Border Classes="KeyCap">
                    <TextBlock Text="{Binding Keys}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="280"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Action}" Classes="Muted" VerticalAlignment="Center" Foreground="{StaticResource SoftTextBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="GAME CONTROLLERS" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <TextBlock Text="{Binding ControllersText}" Classes="RowTitle" FontSize="13.5" TextWrapping="Wrap"/>
          <TextBlock Classes="Muted" Margin="0,6,0,0"
                     Text="South button = decide, east = cancel, west = system menu, north = backlog, shoulders = auto and skip, triggers = rewind and fast-forward, start = quick save."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
