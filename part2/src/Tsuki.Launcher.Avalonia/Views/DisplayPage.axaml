<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Tsuki.Launcher.Avalonia.Views" x:Class="Tsuki.Launcher.Avalonia.Views.DisplayPage">
  <ScrollViewer Classes="Page">
    <StackPanel Margin="0,0,0,24">
      <views:PageHeader Overline="DISPLAY" Title="Window and picture"
                        Description="The game draws a 1920 × 1080 picture and fits it into the window with black bars where the shapes differ. These choices are read when the game starts."/>
      <Border Classes="Card">
        <StackPanel>
          <TextBlock Text="MODE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,4"/>
          <HeaderedContentControl Classes="SettingRow" Header="Fullscreen" Tag="{Binding FullscreenDescription}">
            <CheckBox Classes="Switch" IsChecked="{Binding Fullscreen, Mode=TwoWay}"/>
          </HeaderedContentControl>
          <HeaderedContentControl Classes="SettingRow" Header="VSync" Tag="Wait for the monitor's refresh when showing a frame. Turn it off only if the picture stutters.">
            <CheckBox Classes="Switch" IsChecked="{Binding VSync, Mode=TwoWay}"/>
          </HeaderedContentControl>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="WINDOW SIZE" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,16"/>
          <!-- 520 wide, narrower in a small window (the column stops at 520 and gives way below) -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="520"/></Grid.ColumnDefinitions>
            <ListBox Classes="Segmented" ItemsSource="{Binding WindowSizes}" SelectedItem="{Binding WindowSize, Mode=TwoWay}">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <TextBlock Classes="Muted" Margin="2,12,0,0" Text="{Binding WindowSizeNote}"/>
          <TextBlock Classes="Muted" Margin="2,6,0,0" Text="The game's Config › System › Window Size row offers the same presets."/>
        </StackPanel>
      </Border>

      <Border Classes="Card" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="MONITOR" Classes="SmallCaps"/>
          <Rectangle Classes="GoldDivider" Margin="0,11,0,14"/>
          <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
            <Viewbox Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top">
              <Path Classes="Icon" Data="M3,4.5 L21,4.5 L21,15.5 L3,15.5 Z M12,15.5 L12,19.5 M7.5,19.5 L16.5,19.5" Stroke="{StaticResource MutedBrush}"/>
            </Viewbox>
            <TextBlock Text="The game opens on the display it used last; move its window to another display and it remembers that one." Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
