<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tsuki.Launcher.Avalonia.Themes.Controls">
  <!-- The Windows launcher's styles (src/Tsuki.Launcher/Themes/Theme.xaml), control by control. Text takes its colour and font from the window, so that a list
       item's colour reaches its label. -->

  <!-- ===== text ===== -->
  <Style Selector="TextBlock.Heading">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="TextBlock.RowTitle">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.SmallCaps">
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="2"/>
  </Style>
  <Style Selector="Path.Icon">
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
  </Style>

  <!-- ===== cards ===== -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="22,18,22,20"/>
  </Style>
  <Style Selector="Rectangle.GoldDivider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Fill" Value="{StaticResource GoldLineBrush}"/>
  </Style>
  <Style Selector="Border.KeyCap">
    <Setter Property="Background" Value="#1AFFFFFF"/>
    <Setter Property="BorderBrush" Value="#33BFD2FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Border.Chip">
    <Setter Property="Background" Value="#33121A3A"/>
    <Setter Property="BorderBrush" Value="#40BFD2FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <!-- ===== a setting: title and description on the left, the control on the right, a line under it ===== -->
  <Style Selector="HeaderedContentControl.SettingRow">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" MinHeight="64">
          <StackPanel VerticalAlignment="Center" Margin="0,12,24,12">
            <TextBlock Text="{TemplateBinding Header}" Classes="RowTitle"/>
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Classes="Muted" Margin="0,3,0,0"/>
          </StackPanel>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Bottom"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="HeaderedContentControl.SettingRow:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>

  <!-- ===== buttons: glass (the Windows GhostButton) unless a class says otherwise ===== -->
  <Style Selector="Button">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Background" Value="#10FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ Border#Chrome">
    <Setter Property="Background" Value="#1CFFFFFF"/>
    <Setter Property="BorderBrush" Value="#598FA6FF"/>
  </Style>
  <Style Selector="Button:focus-visible /template/ Border#Chrome">
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
  </Style>
  <Style Selector="Button:pressed /template/ Border#Chrome">
    <Setter Property="Background" Value="#08FFFFFF"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.42"/>
  </Style>

  <Style Selector="Button.AccentButton">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#0A0F24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.AccentButton:pointerover /template/ Border#Chrome">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BoxShadow" Value="0 0 16 0 #995E8BFF"/>
  </Style>
  <Style Selector="Button.AccentButton:focus-visible /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="0 0 16 0 #E69CD2FF"/>
  </Style>
  <Style Selector="Button.AccentButton:pressed /template/ Border#Chrome">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <Style Selector="Button.LinkButton">
    <Setter Property="Foreground" Value="{StaticResource MoonPaleBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="12.5" FontWeight="SemiBold" Background="Transparent"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.LinkButton:pointerover /template/ TextBlock#Text, Button.LinkButton:focus-visible /template/ TextBlock#Text">
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>

  <!-- the big luminous PLAY button -->
  <Style Selector="Button.PlayButton">
    <Setter Property="Width" Value="188"/>
    <Setter Property="Height" Value="54"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="Root">
          <Border x:Name="Glow" CornerRadius="13" Background="{StaticResource AccentBrush}" BoxShadow="0 0 30 0 #8C5E8BFF"/>
          <Border x:Name="Rim" CornerRadius="13" BorderThickness="1" BorderBrush="#66FFFFFF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                <GradientStop Color="#1A0A0F24" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="22" Height="22" Margin="0,1,10,0" VerticalAlignment="Center">
              <Path Classes="Icon" Data="{StaticResource PlayIcon}" Stroke="#0A0F24" StrokeThickness="1.6"/>
            </Viewbox>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#0A0F24" FontFamily="{StaticResource BodyFont}" FontSize="17" FontWeight="Bold" LetterSpacing="3.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.PlayButton:pointerover /template/ Border#Glow">
    <Setter Property="BoxShadow" Value="0 0 38 0 #BF9CD2FF"/>
  </Style>
  <Style Selector="Button.PlayButton:focus-visible /template/ Border#Rim">
    <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.PlayButton:pressed /template/ Panel#Root">
    <Setter Property="Opacity" Value="0.88"/>
  </Style>
  <Style Selector="Button.PlayButton:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.PlayButton:disabled /template/ Border#Glow">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
  </Style>

  <!-- the footer's update button: Log's glass with a sync sign ("Check for updates", "Checking…"), and the gold glass with a download sign and a gold dot once a
       newer release is known (class Gold, set by the window from UpdateButtonAccent) -->
  <Style Selector="Button.UpdateButton">
    <Setter Property="Height" Value="42"/>
    <Setter Property="MinWidth" Value="164"/>
    <Setter Property="Padding" Value="16,0,20,0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="Root">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox x:Name="Sync" Width="17" Height="17" Margin="0,1,8,0" Opacity="0.75" VerticalAlignment="Center">
                <Path Classes="Icon" Data="{StaticResource SyncIcon}" Stroke="{StaticResource MoonPaleBrush}" StrokeThickness="1.9"/>
              </Viewbox>
              <Viewbox x:Name="Down" Width="19" Height="19" Margin="0,1,9,0" IsVisible="False" VerticalAlignment="Center">
                <Path Classes="Icon" Data="{StaticResource DownloadIcon}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.9"/>
              </Viewbox>
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False">
            <Ellipse.RenderTransform><TranslateTransform X="3" Y="-3"/></Ellipse.RenderTransform>
          </Ellipse>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.UpdateButton:pointerover /template/ Viewbox#Sync">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.UpdateButton:disabled">
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Button.UpdateButton.Gold">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="15,0,18,0"/>
    <Setter Property="BorderBrush" Value="#99D9C58E"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#33D9C58E" Offset="0"/>
        <GradientStop Color="#1A5E8BFF" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.UpdateButton.Gold /template/ Border#Chrome">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BoxShadow" Value="0 0 14 0 #47D9C58E"/>
  </Style>
  <Style Selector="Button.UpdateButton.Gold /template/ Viewbox#Sync">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.UpdateButton.Gold /template/ Viewbox#Down, Button.UpdateButton.Gold /template/ Ellipse#Dot">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <!-- hovering the gold button keeps it gold: a brighter rim and glow, never the blue accent -->
  <Style Selector="Button.UpdateButton.Gold:pointerover /template/ Border#Chrome">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#33D9C58E" Offset="0"/>
        <GradientStop Color="#1A5E8BFF" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#E6D9C58E"/>
    <Setter Property="BoxShadow" Value="0 0 20 0 #80D9C58E"/>
  </Style>
  <Style Selector="Button.UpdateButton.Gold:focus-visible /template/ Border#Chrome">
    <Setter Property="BorderBrush" Value="#FFF2E3B8"/>
  </Style>
  <Style Selector="Button.UpdateButton.Gold:pressed /template/ Panel#Root">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <!-- ===== the sidebar ===== -->
  <Style Selector="ListBox.Nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="44" Margin="12,2" Background="Transparent">
          <Border x:Name="Bg" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
          <Border x:Name="Bar" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentVerticalBrush}" Opacity="0" BoxShadow="0 0 10 0 #CC5E8BFF"/>
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
              <Path x:Name="Ico" Classes="Icon" Data="{Binding Glyph, Converter={StaticResource PathData}}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"/>
            </Viewbox>
            <TextBlock x:Name="Txt" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="13,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="#0DFFFFFF"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ TextBlock#Txt">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ Path#Ico">
    <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ Border#Bg">
    <Setter Property="Background" Value="#1F8FA6FF"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ Border#Bar">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ TextBlock#Txt">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ Path#Ico">
    <Setter Property="Stroke" Value="{StaticResource MoonPaleBrush}"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:focus-visible /template/ Border#Bg">
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
  </Style>

  <!-- ===== a segmented choice (language, prompts, window size) ===== -->
  <Style Selector="ListBox.Segmented">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="#66090E22" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="#14FFFFFF"/>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem:focus-visible /template/ Border#Bd">
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem:selected">
    <Setter Property="Foreground" Value="#0A0F24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ListBox.Segmented ListBoxItem:selected /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BoxShadow" Value="0 0 12 0 #735E8BFF"/>
  </Style>

  <!-- ===== four tiles in a row, one chosen (languages) ===== -->
  <Style Selector="ListBox.Tiles">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Tiles ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Bd" Margin="0,0,10,0" Padding="16,18,16,16" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
          <!-- a name wider than its tile (the smallest window) is drawn smaller, not cut -->
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.Tiles ListBoxItem:pointerover /template/ Border#Bd">
    <Setter Property="BorderBrush" Value="#598FA6FF"/>
  </Style>
  <Style Selector="ListBox.Tiles ListBoxItem:selected /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SelectedFillBrush}"/>
    <Setter Property="BorderBrush" Value="#B39CD2FF"/>
    <Setter Property="BoxShadow" Value="0 0 16 0 #595E8BFF"/>
  </Style>
  <Style Selector="ListBox.Tiles ListBoxItem:focus-visible /template/ Border#Bd">
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
  </Style>

  <!-- ===== the switch (a check box), no On / Off text ===== -->
  <Style Selector="CheckBox.Switch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Right">
          <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.Switch:focus-visible /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
  </Style>
  <Style Selector="CheckBox.Switch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="#99FFFFFF"/>
    <Setter Property="BoxShadow" Value="0 0 12 0 #805E8BFF"/>
  </Style>
  <Style Selector="CheckBox.Switch:checked /template/ Ellipse#Knob">
    <Setter Property="Fill" Value="#0A0F24"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
  </Style>
  <Style Selector="CheckBox.Switch:pointerover /template/ Border#Track">
    <Setter Property="BorderBrush" Value="#8C9CD2FF"/>
  </Style>
  <Style Selector="CheckBox.Switch:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>

  <!-- ===== the path box ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="#665E8BFF"/>
    <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- the typed path inherits this (no style may give the box's inner scroll viewer another colour: the text went dim that way) -->
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="BorderBrush" Value="#598FA6FF"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource MoonPaleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- ===== the rest ===== -->
  <Style Selector="ScrollViewer.Page">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <!-- the bar sits in the page margin, so that the content width never changes -->
    <Setter Property="Margin" Value="0,0,-24,0"/>
  </Style>
  <!-- the page keeps clear of that margin: inset as the presenter, not as Padding (the presenter measured the cards 24 px wider than it laid them out, and cut them) -->
  <Style Selector="ScrollViewer.Page /template/ ScrollContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="0,0,24,0"/>
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#40BFD2FF"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Background" Value="#1AFFFFFF"/>
    <Setter Property="BorderBrush" Value="#268FA6FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource PanelSolidBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
  </Style>
</Styles>
